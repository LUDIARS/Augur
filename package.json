{
  "name": "augur",
  "version": "0.1.0",
  "description": "Purpose-driven test planning and fix policy service",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/http/main.ts",

{
  "name": "augur",
  "version": "0.1.0",
  "description": "Purpose-driven test planning and fix policy CLI",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types bin/augur.mjs serve",
    "start": "node bin/augur.mjs serve",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "golden:update": "node --experimental-strip-types scripts/update-golden.ts",
    "inject": "node --experimental-strip-types scripts/inject-logs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "augur": "node bin/augur.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.12.0",
    "pino": "^9.14.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "augur": "bin/augur.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "spec",
    "README.md"
  ]
}
